pipeline {
    agent {
        node {
            label 'agent1'
        }
    }
    environment {
        COURSE = "Jenkins"
    }
    options {
        timeout(time: 10, unit: 'MINUTES') 
        disableConcurrentBuilds()
        ansiColor('xterm')
    }
    stages {
        stage('Init') {
            steps {
                script{
                    withAWS(region:'us-east-1',credentials:'aws-auth') {
                        sh """
                            cd 10-sg
                            terraform init
                        """
                    }
                }
            }
        }
        stage('Plan') {
            steps {
                script{
                    withAWS(region:'us-east-1',credentials:'aws-auth') {
                        sh """
                            cd 10-sg
                            terraform plan
                        """
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
                script{
                    withAWS(region:'us-east-1',credentials:'aws-auth') {
                        sh """
                            cd 10-sg
                            terraform apply -auto-approve
                        """
                    }
                }
            }
        }
        stage('Trigger downstream'){
            parallel{
                stage('20-bastion'){
                    steps{
                        script{
                            build job: '20-bastion',
                            propogate: false
                            wait: false
                        }
                    }
                }
                stage('30-sg-rules'){
                    steps{
                        script{
                            build job: '30-sg-rules',
                            propogate: false
                            wait: false
                        }
                    }
                }
                stage('70-acm'){
                    steps{
                        script{
                            build job: '70-acm',
                            propogate: false
                            wait: false
                        }
                    }
                }
                stage('80-frontend-alb'){
                    steps{
                        script{
                            build job: '80-frontend-alb',
                            propogate: false
                            wait: false
                        }
                    }
                }
                stage('90-eks'){
                    steps{
                        script{
                            build job: '90-eks',
                            propogate: false
                            wait: false
                        }
                    }
                }
                stage('40-ecr'){
                    steps{
                        script{
                            build job: '40-ecr',
                            propogate: false
                            wait: false
                        }
                    }
                }
            }
        }
    }
    post{
        always{
            echo 'I will always say Hello again!'
        }
        success {
            echo 'I will run if success'
        }
        failure {
            echo 'I will run if failure'
        }
        aborted {
            echo 'pipeline is aborted'
        }
    }
}
