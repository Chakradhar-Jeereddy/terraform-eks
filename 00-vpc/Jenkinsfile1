pipeline{
    agent{
        node{
            label "agent1"
        }
    }
    options{
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
        ansiColor('xterm')

    }
    environment{
        course = 'devops'
    }
    stages{
        stage('Initialize'){
            steps{
                withAWS(credentials: 'aws-auth', region: 'us-east-1'){
                   sh """
                    cd 00-vpc
                    terraform init
                   """
                }
            }
        }
        stage('planning'){
            steps{
                withAWS(credentials: 'aws-auth', region: 'us-east-1'){
                    sh """
                      cd 00-vpc
                      terraform plan
                    """
                }
            }
        }
        stage('deploying'){
            steps{
                withAWS(credentials: 'aws-auth', region: 'us-east-1'){
                    sh """
                      cd 00-vpc
                      terraform apply --auto-approve
                    """
                }
            }
        }
        stage('trigger 10-sg') {
            steps {
                script{
                    build job: '10-sg',
                    wait: false,  
                    propagate: false  // Fail this pipeline if downstream fails
                }
            } 
        }   
    }
}