pipeline{
    agent{
        node{
            label "agent1"
        }
    }
    options{
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
    }
    environment{
        course = 'devops'
    }
    stages{
        stage('Initialize'){
            steps{
                withAWS(credentials: 'aws-auth', region: 'us-east-1'){
                   sh """
                    cd 00-vpc
                    terraform init
                   """
                }
            }
        }
        stage('planning'){
            steps{
                withAWS(credentials: 'aws-auth', region: 'us-east-1'){
                    sh """
                      cd 00-vpc
                      terraform plan
                    """
                }
            }
        }
    }
}